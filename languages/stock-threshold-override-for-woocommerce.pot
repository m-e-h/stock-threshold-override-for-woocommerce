#. Plugin Name of the plugin
#: stock-threshold-override-for-woocommerce.php
msgid "Stock Threshold Override for WooCommerce"
msgstr ""

#. Description of the plugin
#: stock-threshold-override-for-woocommerce.php
msgid "Let selected products and their variations sell down to zero stock instead of using the store-wide out-of-stock threshold."
msgstr ""

#. Author of the plugin
#: stock-threshold-override-for-woocommerce.php
msgid "Marty Helmick"
msgstr ""

#: includes/class-plugin.php:67
msgid "Ignore out-of-stock threshold"
msgstr ""

#: includes/class-plugin.php:68
msgid "Keep this product and its variations in stock while tracked quantity is above 0, instead of using the store-wide threshold. Backorder settings still apply."
msgstr ""

#: stock-threshold-override-for-woocommerce.php:53
msgid "Stock Threshold Override for WooCommerce requires WooCommerce 9.0 or newer. Install or update WooCommerce to use the product inventory setting."
msgstr ""
